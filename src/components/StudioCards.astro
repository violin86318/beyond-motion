---
import SiteCard from './SiteCard.astro';
import { getSites } from '../lib/sites.mjs';
const studios = getSites({ category: 'tools' });
---
<div class="studio-entries">
  {studios.map(site => <SiteCard site={site} sizes="(max-width: 720px) calc(100vw - 44px), (max-width: 1320px) calc((100vw - 144px) / 2), 588px" />)}
</div>
<style>
  .studio-entries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 32px}
  @media(max-width:720px){.studio-entries{grid-template-columns:1fr}}
</style>
