---
import '../styles/tokens.css';
interface Props { title: string; description?: string; image?: string; }
const { title, image = '/w/dingying-fix/cover-bilibili.jpg', description = 'violin 的创作现场：影像、音乐、文章，以及把想法变成作品的小工具。言上文化 · Beyond-Motion。' } = Astro.props;
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['/works','作品'],['/notes','文章'],['/music','音乐'],['/studio','石榴工作室'],['/about','关于']];
---
<!doctype html><html lang="zh-CN"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} — violin · Beyond-Motion</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} />
<meta property="og:title" content={`${title} — violin · Beyond-Motion`} /><meta property="og:description" content={description} />
<meta property="og:type" content={Astro.url.pathname.startsWith('/notes/') ? 'article' : 'website'} />
<meta property="og:locale" content="zh_CN" /><meta property="og:image" content={new URL(image,Astro.site)} />
<meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content="#f4f1e8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="alternate" type="application/rss+xml" title="violin 的文章" href="/rss.xml" />
</head><body><a href="#main" class="skip">跳到正文</a><div class="shell">
<header class="ruler"><a class="brand" href="/">violin<span>BEYOND—MOTION</span></a><nav aria-label="主导航">{nav.map(([url,label])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}</nav></header>
<main id="main"><slot /></main><footer><a class="brand" href="/">violin<span>让想法，成为作品。</span></a><div class="footer-links"><a href="/rss.xml">RSS 订阅</a><a href="/privacy">隐私说明</a><a href="https://space.bilibili.com/19258410" target="_blank" rel="noopener noreferrer">Bilibili ↗</a><span>© {year} Beyond-Motion</span></div></footer></div></body></html>
<style>
.shell{max-width:1320px;margin:auto;padding:0 56px}.ruler{display:flex;justify-content:space-between;align-items:center;gap:28px;padding:28px 0;border-bottom:1px solid var(--ink)}.brand{font-size:30px;font-family:var(--serif);font-weight:900;text-decoration:none;line-height:1}.brand span{display:block;font-family:var(--mono);font-size:9px;letter-spacing:.16em;margin-top:10px;font-weight:400;color:var(--quiet)}nav{display:flex;gap:28px;flex-wrap:wrap}nav a{font-size:13px;text-decoration:none;padding:10px 0}nav a[aria-current],nav a:hover{color:var(--or);text-decoration:underline;text-underline-offset:8px}main{min-height:60vh}footer{border-top:1px solid var(--ink);padding:36px 0 44px;margin-top:100px;display:flex;justify-content:space-between;gap:30px}.footer-links{display:flex;gap:22px;align-items:center;flex-wrap:wrap;font-size:11px;color:var(--quiet)}.skip{position:absolute;top:-100px;background:var(--ink);color:var(--paper);padding:12px;z-index:10}.skip:focus{top:0}@media(max-width:720px){.shell{padding:0 22px}.ruler{align-items:flex-start;flex-direction:column;padding:22px 0;gap:20px}nav{gap:23px}nav a{font-size:12px}footer{flex-direction:column;margin-top:64px}.footer-links{gap:18px}}
</style>
