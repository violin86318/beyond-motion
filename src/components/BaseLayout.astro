---
/** BaseLayout — 全站骨架：字体、PlotterLines 背景、ruler 导航、页脚、
 *  签名交互（十字光标+坐标、滚动 reveal）、页面转场、工艺细节。 */
import '../styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
import PlotterLines from './PlotterLines.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'violin / 言上文化 · Beyond-Motion — 在 AI 协作下生成影像、音乐、图像与文字。' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — violin · Beyond-Motion</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} — violin · Beyond-Motion`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Sans+SC:wght@400;700;900&family=Noto+Serif+SC:wght@600;900&display=swap" rel="stylesheet" />
  <ClientRouter />
</head>
<body>
  <PlotterLines />

  <!-- 签名交互：十字准星光标 + 实时坐标（仅精确指针设备） -->
  <div id="cursor" aria-hidden="true">
    <span class="ch"></span>
    <span class="cv"></span>
    <span class="coord" id="cursor-coord">X:0000 Y:0000</span>
  </div>

  <div class="shell">
    <header class="ruler">
      <a class="brand" href="/">violin <span>· Beyond-Motion</span></a>
      <nav>
        <a href="/">首页</a>
        <a href="/works">作品</a>
        <a href="/notes">手记</a>
        <a href="/about">关于</a>
      </nav>
      <span class="rev annot">REV.{year}</span>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span class="annot">© {year} violin · Beyond-Motion</span>
      <span class="annot">BUILT WITH CODE, LIKE EVERYTHING ELSE HERE</span>
      <span class="links annot">
        <a href="https://space.bilibili.com/19258410" target="_blank" rel="noopener">BILIBILI</a>
      </span>
    </footer>
  </div>

  <script>
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── 十字光标 ─────────────────────────── */
    function initCursor() {
      if (!matchMedia('(pointer:fine)').matches || reduced) return;
      const cur = document.getElementById('cursor')!;
      const label = document.getElementById('cursor-coord')!;
      document.body.classList.add('has-cursor');
      let tx = innerWidth / 2, ty = innerHeight / 2, x = tx, y = ty, raf = 0;
      const loop = () => {
        x += (tx - x) * .22;
        y += (ty - y) * .22;
        cur.style.transform = `translate(${x}px, ${y}px)`;
        raf = requestAnimationFrame(loop);
      };
      addEventListener('mousemove', e => {
        tx = e.clientX; ty = e.clientY;
        label.textContent = `X:${String(Math.round(tx)).padStart(4, '0')} Y:${String(Math.round(ty)).padStart(4, '0')}`;
        cur.classList.add('on-screen');
        if (!raf) raf = requestAnimationFrame(loop);
      }, { passive: true });
      document.addEventListener('mouseleave', () => cur.classList.remove('on-screen'));
      // 悬停可交互元素时准星变橙放大
      document.addEventListener('mouseover', e => {
        const t = (e.target as HTMLElement).closest('a,button,[data-hover]');
        cur.classList.toggle('hot', !!t);
      }, { passive: true });
    }

    /* ── 滚动 reveal ──────────────────────── */
    let io: IntersectionObserver | null = null;
    function initReveal() {
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.in)');
      if (!els.length) return;
      if (reduced) { els.forEach(el => el.classList.add('in')); return; }
      io?.disconnect();
      io = new IntersectionObserver(entries => {
        for (const en of entries) {
          if (en.isIntersecting) {
            (en.target as HTMLElement).classList.add('in');
            io!.unobserve(en.target);
          }
        }
      }, { threshold: .12, rootMargin: '0px 0px -6% 0px' });
      els.forEach(el => io!.observe(el));
    }

    initCursor();
    initReveal();
    document.addEventListener('astro:page-load', () => { initCursor(); initReveal(); });
  </script>
</body>
</html>

<style>
  .shell {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main { flex: 1; }

  .ruler {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 20px 0 16px;
    border-bottom: 1px solid var(--faint);
  }
  .ruler .brand {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .12em;
    text-decoration: none;
  }
  .ruler .brand span { font-weight: 400; color: var(--or); }
  .ruler nav { display: flex; gap: 28px; }
  .ruler nav a {
    font-size: 12px;
    letter-spacing: .22em;
    color: var(--quiet);
    text-decoration: none;
    position: relative;
    padding-bottom: 3px;
    transition: color .25s;
  }
  /* 导航下划线扫入 */
  .ruler nav a::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 1px;
    background: var(--or);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .35s cubic-bezier(.22, 1, .36, 1);
  }
  .ruler nav a:hover { color: var(--or); }
  .ruler nav a:hover::after { transform: scaleX(1); transform-origin: left; }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding: 40px 0 48px;
    margin-top: 80px;
    border-top: 1px solid var(--faint);
  }
  footer .links { display: flex; gap: 20px; }
  footer .links a { color: var(--quiet); text-decoration: none; }
  footer .links a:hover { color: var(--or); }

  /* ── 十字准星光标 ── */
  #cursor {
    position: fixed;
    left: 0; top: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s;
    will-change: transform;
  }
  #cursor.on-screen { opacity: 1; }
  #cursor .ch, #cursor .cv {
    position: absolute;
    background: var(--ink);
    transition: background .2s;
  }
  #cursor .ch { left: -11px; top: 0; width: 22px; height: 1px; }
  #cursor .cv { left: 0; top: -11px; width: 1px; height: 22px; }
  #cursor .coord {
    position: absolute;
    left: 16px; top: 12px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .1em;
    color: var(--quiet);
    white-space: nowrap;
    transition: color .2s;
  }
  #cursor.hot .ch, #cursor.hot .cv { background: var(--or); }
  #cursor.hot .ch { left: -15px; width: 30px; }
  #cursor.hot .cv { top: -15px; height: 30px; }
  #cursor.hot .coord { color: var(--or); }
  body.has-cursor, body.has-cursor a, body.has-cursor button { cursor: none; }

  /* ── 滚动 reveal ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity .8s cubic-bezier(.22, 1, .36, 1), transform .8s cubic-bezier(.22, 1, .36, 1);
    transition-delay: var(--rd, 0s);
  }
  [data-reveal].in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001s !important;
      transition-duration: .001s !important;
    }
    [data-reveal] { opacity: 1; transform: none; }
  }

  @media (max-width: 720px) {
    .shell { padding: 0 20px; }
    .ruler { flex-wrap: wrap; }
    .ruler .rev { display: none; }
  }
</style>
