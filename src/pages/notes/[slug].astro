---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({data}) => !data.draft))
    .sort((a, b) => b.data.date.localeCompare(a.data.date));
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, no: String(i + 1).padStart(3, '0') },
  }));
}

const { note, no } = Astro.props;
const { title, date, kind } = note.data;
const { Content } = await render(note);
const KIND: Record<string, string> = { log: '手记', piece: '文章' };
---
<BaseLayout title={title} description={note.data.description}>
  <article class="note">
    <header>
      <div class="row annot">
        <a href="/notes" class="back">← 手记</a>
        <span>NO.{no} · {KIND[kind]} · {date}</span>
      </div>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .note { max-width: 720px; margin: 0 auto; }
  header { padding: 72px 0 44px; }
  .row { display: flex; gap: 20px; margin-bottom: 26px; }
  .back { text-decoration: none; }
  .back:hover { color: var(--or); }
  h1 {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.3;
    letter-spacing: .02em;
  }
  .prose {
    font-family: var(--serif);
    font-size: 16.5px;
    line-height: 2.2;
    color: rgba(28, 26, 22, .88);
  }
  .prose :global(p) { margin-bottom: 1.6em; }
  .prose :global(h2) {
    font-size: 22px;
    font-weight: 900;
    margin: 2.2em 0 1em;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--or);
    padding-left: 20px;
    color: var(--quiet);
    margin: 1.6em 0;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: .85em;
    background: rgba(28, 26, 22, .07);
    padding: 2px 6px;
  }
  .prose :global(pre) {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.8;
    background: rgba(28, 26, 22, .05);
    border: 1px solid var(--faint);
    padding: 18px 20px;
    overflow-x: auto;
    margin: 1.6em 0;
  }
  .prose :global(pre code) { background: none; padding: 0; }
</style>
