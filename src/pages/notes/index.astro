---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';

const notes = (await getCollection('notes', ({data}) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<BaseLayout title="文章与手记">
  <section class="head" data-reveal>
    <span class="annot">WORDS / 文章与手记</span>
    <h1>追问者的手记</h1>
    <p class="annot">{notes.length} 篇 · 学习笔记与 AI 协作写作的成品</p>
  </section>

  <NoteList notes={notes} heading="h2" />
</BaseLayout>

<style>
  .head { padding: 80px 0 56px; }
  .head h1 {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: .02em;
    margin: 16px 0 12px;
  }

</style>
