---
import BaseLayout from '../components/BaseLayout.astro';
const media = [
 {id:'films', name:'影像', en:'FILM / MOTION', href:'/works/', text:'实时影像、音乐短片与运动的画面。'},
 {id:'visual', name:'图像', en:'IMAGE / PAPER', href:'/visuals/', text:'视觉日刊、纸面观察与图像创作。'},
 {id:'music', name:'音乐', en:'MUSIC / SOUND', href:'/music/', text:'专辑听室、灵感音乐与风格听室。'},
];
---
<BaseLayout title="创作现场">
<section class="hero"><div class="hero-copy"><p class="eyebrow">Independent creator / violin</p><h1>从影像出发，<br/>让想法<br/><em>不止于想。</em></h1><p class="intro">我是 violin。十年影视创作，现在与 AI 一起，<br class="desktop"/>把追问写成文章，把感受做成音乐和影像。</p><div class="actions"><a class="button" href="/about/">认识 violin →</a><a class="button secondary" href="/reading/">读最近的文章 →</a></div></div>
<nav class="medium-index" aria-label="创作分类">{media.map((item,index)=><a href={item.href} data-medium-entry={item.id}><span class="annot">0{index+1} / {item.en}</span><h2>{item.name}<span aria-hidden="true">→</span></h2><p>{item.text}</p></a>)}</nav></section>
<div class="index-strip"><span>言上文化 · BEYOND-MOTION</span><span>影像 / 图像 / 音乐 / 文字</span></div>
<section class="other-routes" aria-label="继续探索"><a href="/reading/"><span class="eyebrow">Reading</span><h2>阅读 →</h2><p>原创文章、中文编译与科技资讯。</p></a><a href="/tools/"><span class="eyebrow">Tools</span><h2>工具 →</h2><p>从具体需要出发，做顺手的小产品。</p></a><a href="/sites/"><span class="eyebrow">The constellation</span><h2>全部小站 →</h2><p>在一个目录里，找到各自生长的入口。</p></a></section>
<section class="endnote"><span class="eyebrow">The person behind the work</span><p>媒介一直在变。<br/>把事情讲清楚的心意没变。</p><a href="/about">认识 violin →</a></section>
</BaseLayout>
<style>
.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:65px;padding:72px 0 58px;align-items:center}.hero h1{font-size:clamp(44px,5.4vw,76px);line-height:1.2;letter-spacing:-.055em;margin:24px 0}.hero em{font-family:var(--serif);font-weight:500;font-style:normal;color:var(--or)}.intro{font-size:14px;line-height:2;color:var(--quiet)}
.medium-index{display:grid;border-top:1px solid var(--ink)}.medium-index a{display:block;padding:24px 0;border-bottom:1px solid var(--faint);text-decoration:none}.medium-index .annot{color:var(--quiet)}.medium-index h2{font:700 36px/1.4 var(--serif);display:flex;justify-content:space-between;margin:10px 0}.medium-index h2 span{font:26px var(--sans);color:var(--or)}.medium-index p{font-size:13px;line-height:1.9;color:var(--quiet)}.medium-index a:hover h2,.other-routes a:hover h2{color:var(--or)}
.index-strip{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--faint);padding-top:18px;font:10px var(--mono);letter-spacing:.1em;color:var(--quiet)}.other-routes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:64px}.other-routes a{text-decoration:none;padding:24px 0;border-top:1px solid var(--ink)}.other-routes h2{font:700 25px var(--serif);margin:18px 0 12px}.other-routes p{font-size:13px;line-height:1.9;color:var(--quiet)}.endnote{text-align:center;padding:64px 0 0}.endnote p{font:26px/1.7 var(--serif);margin:24px 0}.endnote a{font-size:13px}
@media(max-width:720px){.hero{grid-template-columns:1fr;padding-top:40px;gap:36px}.hero h1{font-size:52px}.medium-index h2{font-size:30px}.index-strip{flex-direction:column;gap:8px}.other-routes{grid-template-columns:1fr;gap:12px;margin-top:40px}.desktop{display:none}}
</style>
