---
import {getCollection} from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import StudioCards from '../components/StudioCards.astro';
const notes=(await getCollection('notes',({data})=>!data.draft)).sort((a,b)=>b.data.date.localeCompare(a.data.date)).slice(0,3);
---
<BaseLayout title="创作现场">
<section class="hero"><div class="hero-copy"><p class="eyebrow">Independent creator / violin</p><h1>从影像出发，<br/>让想法<br/><em>不止于想。</em></h1><p class="intro">我是 violin。十年影视创作，现在与 AI 一起，<br class="desktop"/>把追问写成文章，把感受做成音乐和影像。</p><div class="actions"><a class="button" href="/works">进入作品现场 ↗</a><a class="button secondary" href="/notes">读最近的文章 →</a></div></div>
<a class="hero-film" href="/works/dingying-fix"><div class="film-label"><span>SELECTED WORK / 001</span><span>实时影像 · 含声音</span></div><img src="/w/dingying-fix/poster.jpg" alt="《定影 FIX》作品画面：胶片与显影中的光" width="960" height="540" fetchpriority="high"/><div class="film-caption"><div><span class="eyebrow">A film made of code</span><h2>定影 <i>FIX</i></h2></div><span class="play" aria-label="查看作品">↗</span></div><p>让代码显影，让声音留下形状。</p></a></section>
<div class="index-strip"><span>言上文化 · BEYOND-MOTION</span><span>影像 / 音乐 / 文字 / 实验</span></div>
<section class="writing"><div class="section-title"><h2><small>01</small>最近在想</h2><a href="/notes">全部文章 →</a></div>{notes.map((n,i)=><a class="note-row" href={`/notes/${n.id}`}><span class="annot">0{i+1} / {n.data.date}</span><div><h3>{n.data.title}</h3><p>{n.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</section>
<section class="music-band"><div><p class="eyebrow">02 / Music, in another form</p><h2>有些话，<br/>适合唱出来。</h2></div><div><p>旋律是另一种写作。原创歌曲、声音实验和创作记录，收在我的音乐站里。</p><a class="button" href="/music">去听一会儿 ↗</a></div><span class="staff" aria-hidden="true">〰</span></section>
<section class="studio"><div class="section-title"><h2><small>03</small>石榴工作室</h2><a href="/studio">关于这些小工具 →</a></div><StudioCards /></section>
<section class="endnote"><span class="eyebrow">The person behind the work</span><p>媒介一直在变。<br/>把事情讲清楚的心意没变。</p><a href="/about">认识 violin →</a></section>
</BaseLayout>
<style>
.hero{display:grid;grid-template-columns:1fr 1fr;gap:55px;padding:72px 0 58px;align-items:center}.hero h1{font-size:clamp(44px,5.4vw,76px);line-height:1.2;letter-spacing:-.055em;margin:24px 0}.hero em{font-family:var(--serif);font-weight:500;font-style:normal;color:var(--or)}.intro{font-size:14px;line-height:2;color:var(--quiet)}.hero-film{text-decoration:none;display:block;margin-top:36px}.film-label{font:9px var(--mono);letter-spacing:.1em;display:flex;justify-content:space-between;padding-bottom:13px;color:var(--quiet)}.hero-film img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;display:block;background:#171715}.film-caption{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--faint);padding:22px 0 16px}.film-caption h2{font-size:34px;margin-top:10px}.film-caption i{font:italic 28px var(--serif);margin-left:12px}.play{border:1px solid var(--ink);border-radius:50%;width:48px;height:48px;display:grid;place-items:center;font-size:23px}.hero-film:hover .play{background:var(--ink);color:var(--paper)}.hero-film>p{font-size:12px;color:var(--quiet);margin-top:12px}.index-strip{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--faint);padding-top:18px;font:10px var(--mono);letter-spacing:.1em;color:var(--quiet)}.writing{margin-top:84px}.note-row{display:grid;grid-template-columns:150px 1fr 30px;gap:24px;text-decoration:none;padding:28px 0;border-bottom:1px solid var(--faint);align-items:baseline}.note-row h3{font:700 25px var(--serif);margin-bottom:12px}.note-row p{font-size:13px;line-height:1.9;color:var(--quiet);max-width:52em}.note-row:hover h3{color:var(--or)}.music-band{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;background:#e8e4d9;margin:84px 0;padding:44px}.music-band h2{font:500 clamp(36px,4vw,52px)/1.35 var(--serif);margin-top:20px}.music-band p:not(.eyebrow){max-width:26em;font-size:14px;line-height:2;margin-bottom:24px}.staff{position:absolute;right:40px;bottom:-100px;font-size:300px;opacity:.05;pointer-events:none}.endnote{text-align:center;padding:88px 0 0}.endnote p{font:26px/1.7 var(--serif);margin:24px 0}.endnote a{font-size:13px}@media(max-width:850px){.hero{gap:30px}.hero h1{font-size:50px}}@media(max-width:720px){.hero{grid-template-columns:1fr;padding-top:40px;gap:30px}.hero h1{font-size:52px}.hero-film{margin-top:0}.hero-film img{aspect-ratio:16/10}.index-strip{flex-direction:column;gap:8px}.note-row{grid-template-columns:1fr 20px;gap:14px}.note-row>.annot{grid-column:1/-1}.note-row h3{font-size:23px}.music-band{grid-template-columns:1fr;gap:30px;padding:30px 24px;margin:60px 0}.writing{margin-top:60px}.desktop{display:none}}
</style>
