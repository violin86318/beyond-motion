---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';

const featured = (await getCollection('works', ({ data }) => data.featured))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const MEDIA = [
  { key: 'live', title: '影像 VIDEO', desc: '会自己运行的影像。Canvas / WebGL 实时渲染，或代码逐帧渲染成片——点开即播放，或点开即运行。', href: '/works#live' },
  { key: 'music', title: '音乐 MUSIC', desc: '写给画面的声音。AI 作曲与声音设计，为影像服务的旋律实验。', href: '/works#music' },
  { key: 'image', title: '图像 IMAGE', desc: '把噪声当作信号，把信号当作图。关于「机器如何看见」的小型研究。', href: '/works#image' },
  { key: 'text', title: '文字 TEXT', desc: '追问者的手记。学习笔记与 AI 协作写作的成品——未成体系，但足够诚实。', href: '/notes' },
];

// Hero 标题逐字拆分（入场编排用）
const L1 = [...'十年影视，'];
const L2 = [...'如今用代码追问。'];
---
<BaseLayout title="首页">
  <section class="hero">
    <span class="annot c1">X:0000</span>
    <span class="annot c2">Y:0000</span>
    <span class="annot c3">SCALE 1:1</span>
    <span class="annot c4">FIG.01 — INDEX</span>
    <span class="cross" style="right:8%;top:32%"></span>
    <span class="cross" style="right:24%;top:60%"></span>
    <span class="vtext annot" aria-hidden="true">TEXT-BASED GENERATIVE ABSTRACTION · 文字编码生成线性抽象</span>

    <div class="eyebrow annot">CODE AS WORK — 代码即作品</div>
    <h1 aria-label="十年影视，如今用代码追问。">
      <span class="line">
        {L1.map((ch, i) => <span class="mask"><span class="char" style={`--d:${.15 + i * .055}s`}>{ch}</span></span>)}
      </span>
      <span class="line">
        {L2.slice(0, -2).map((ch, i) => <span class="mask"><span class="char" style={`--d:${.15 + (L1.length + i) * .055}s`}>{ch}</span></span>)}<span class="nobr">{L2.slice(-2).map((ch, k) => <span class="mask"><span class="char" style={`--d:${.15 + (L1.length + L2.length - 2 + k) * .055}s`}>{ch}</span></span>)}</span>
      </span>
    </h1>
    <div class="rule" aria-hidden="true"></div>
    <p class="lede">我是 violin。一个不懂代码的创作者，如今在 AI 的协助下把想法变成可运行的作品——影像、音乐、图像与文字。每一件作品都从一个真实的困惑开始，以一段代码结束。</p>
  </section>

  <section class="story" data-reveal>
    <p>过去十年我在影视行业，用镜头讲故事；现在我把镜头换成了代码。这个网站是我的开放式实验室：所有作品都由 AI 协作、代码生成，源码与过程全部公开。我相信提问比答案重要，过程比结果值钱——<em>品味是知识的导数</em>。</p>
  </section>

  <div class="index-head" data-reveal>
    <h2 class="annot">WORKS / 精选作品</h2>
    <a class="annot more" href="/works">全部作品 →</a>
  </div>
  <div class="works">
    {featured.map((w, i) => <WorkCard no={String(i + 1).padStart(3, '0')} work={w} delay={`${i * .08}s`} />)}
  </div>

  <div class="index-head" data-reveal>
    <h2 class="annot">MEDIUMS / 四个媒介</h2>
  </div>
  <div class="media" data-reveal>
    {MEDIA.map(m => (
      <a class="medium" href={m.href}>
        <span class="annot">{m.title}</span>
        <p>{m.desc}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 96px 0 110px;
    border-bottom: 1px solid var(--faint);
  }
  .hero .c1 { position: absolute; top: 22px; left: 0; }
  .hero .c2 { position: absolute; top: 22px; right: 0; }
  .hero .c3 { position: absolute; bottom: 16px; left: 0; }
  .hero .c4 { position: absolute; bottom: 16px; right: 0; }
  .cross { position: absolute; width: 15px; height: 15px; }
  .cross::before, .cross::after { content: ""; position: absolute; background: var(--or); }
  .cross::before { left: 7px; top: 0; width: 1px; height: 15px; }
  .cross::after { top: 7px; left: 0; height: 1px; width: 15px; }
  .vtext {
    position: absolute;
    right: -8px; top: 50%;
    writing-mode: vertical-rl;
    letter-spacing: .3em !important;
    opacity: .7;
  }

  .eyebrow {
    color: var(--or) !important;
    letter-spacing: .34em !important;
    margin-bottom: 26px;
    animation: fade-in 1s cubic-bezier(.22, 1, .36, 1) both;
  }
  .hero h1 {
    font-weight: 900;
    font-size: clamp(40px, 7.5vw, 104px);
    line-height: 1.08;
    letter-spacing: -.01em;
  }
  .hero h1 .line { display: block; }
  .hero h1 .nobr { display: inline-block; white-space: nowrap; }
  .hero h1 .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }
  .hero h1 .char {
    display: inline-block;
    transform: translateY(112%);
    animation: char-up .9s cubic-bezier(.22, 1, .36, 1) both;
    animation-delay: var(--d);
  }
  @keyframes char-up { to { transform: translateY(0); } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

  /* 标题后的橙色扫线 */
  .rule {
    width: 100%;
    height: 1px;
    margin-top: 34px;
    background: linear-gradient(90deg, var(--or), rgba(255, 90, 31, 0));
    transform: scaleX(0);
    transform-origin: left;
    animation: rule-draw 1.2s cubic-bezier(.22, 1, .36, 1) .9s both;
  }
  @keyframes rule-draw { to { transform: scaleX(1); } }

  .lede {
    margin-top: 24px;
    font-size: 15.5px;
    line-height: 2;
    color: var(--quiet);
    max-width: 34em;
    animation: fade-up .9s cubic-bezier(.22, 1, .36, 1) 1.05s both;
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .story {
    padding: 56px 0;
    border-bottom: 1px solid var(--faint);
  }
  .story p {
    font-family: var(--serif);
    font-size: clamp(17px, 2vw, 21px);
    line-height: 2.1;
    max-width: 36em;
  }
  .story em { font-style: normal; color: var(--or); }

  .index-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 48px 0 18px;
  }
  .index-head h2 { font-weight: 400; letter-spacing: .3em !important; font-size: 12px !important; }
  .more { text-decoration: none; }
  .more:hover { color: var(--or); }

  .works { border-top: 1px solid var(--faint); }

  .media {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--faint);
    border-left: 1px solid var(--faint);
    margin-top: 8px;
  }
  .medium {
    padding: 24px 20px 28px;
    border-right: 1px solid var(--faint);
    border-bottom: 1px solid var(--faint);
    text-decoration: none;
    display: grid;
    gap: 14px;
    align-content: start;
    position: relative;
    overflow: hidden;
    transition: background .25s;
  }
  /* 媒介卡片 hover：底部橙线扫入 + 文字上浮 */
  .medium::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 2px;
    background: var(--or);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .4s cubic-bezier(.22, 1, .36, 1);
  }
  .medium:hover::after { transform: scaleX(1); transform-origin: left; }
  .medium:hover { background: rgba(255, 90, 31, .05); }
  .medium:hover .annot { color: var(--or); }
  .medium p { font-size: 12.5px; line-height: 1.9; color: var(--quiet); transition: transform .35s cubic-bezier(.22, 1, .36, 1); }
  .medium:hover p { transform: translateY(-2px); }

  @media (max-width: 720px) {
    .hero { padding: 64px 0 72px; }
    .vtext { display: none; }
    .media { grid-template-columns: 1fr 1fr; }
  }
</style>
