---
import BaseLayout from '../components/BaseLayout.astro';
import SiteCard from '../components/SiteCard.astro';
import { getSites, resolveSiteLink } from '../lib/sites.mjs';
const musicSites = getSites({ category: 'music' });
const selectedSite = musicSites.find(site => site.id === 'album-room');
const selected = selectedSite?.url.replace(/\/$/, '');
const collections = [
 {id:'graduation',title:'六月之后',count:4,description:'毕业季 / 同桌、合照与新的出发'},
 {id:'convenience-store',title:'便利店，夜还亮着',count:6,description:'便利店 / 白灯、热食与夜班的人'},
 {id:'memory-darkroom',title:'记忆的暗房',count:3,description:'时间、身体与记忆的显影'},
 {id:'unspoken',title:'尚未说出口',count:3,description:'语言、相遇与表达'}
];
const selectedCount = collections.reduce((total, collection) => total + collection.count, 0);
const songs = [
 ['dingying','定影','记忆慢慢显影','创作手记'],['qiwei','气味先到','身体比语言更早记得','创作手记'],['nianlun','年轮','持续记录，持续生长','创作手记'],
 ['tuigejian','退格键','一次终于留下的表达','作品解读'],['lingdian','零点前三十秒','陌生人之间短暂的共同体','创作手记'],['zhangwen','掌纹','表达里不可复制的痕迹','创作手记']
];

---
<BaseLayout title="音乐" description="violin 的音乐：专辑听室、灵感音乐与风格听室。按主题慢慢听，也沿着灵感与曲风发现新的声音。">
 <header class="music-hero"><div class="hero-copy"><p class="eyebrow">Listening room / Violin’s Listening Room</p><h1>把感受，<br/>留在声音里。</h1><p class="hero-intro">把作品编成一张专辑，从生活里写下一首歌，或沿着曲风探索。三个入口，各自有回声。</p><nav class="music-entries" aria-label="音乐入口">{musicSites.map(site=>{const link=resolveSiteLink(site.url);return <a data-music-entry-id={site.id} class="button secondary" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{site.name} <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span></a>})}</nav></div><div class="disc" aria-hidden="true"><span>violin<br/><small>MUSIC / SOUND</small></span></div></header>
 <section class="music-sites" aria-labelledby="music-sites-heading"><div class="section-title"><h2 id="music-sites-heading">从这里，开始听。</h2><p>主题选集 / 生活灵感 / 曲风探索</p></div><div class="site-grid">{musicSites.map(site=><SiteCard site={site} />)}</div><p class="small">在新窗口打开，播放由你开始。音乐站的红心保存在当前浏览器，不跨设备或跨站同步。</p></section>
 {selected && <section class="music-section"><div class="section-title"><h2>选一张，慢慢听。</h2><p>{collections.length} 张主题选集 / {selectedCount} 首作品</p></div><div class="song-index">{collections.map(collection=><a href={`${selected}/collections/${collection.id}/`} target="_blank" rel="noopener noreferrer"><span>主题选集 / {collection.count} 首</span><strong>{collection.title} ↗</strong><small>{collection.description}</small></a>)}</div></section>}
 {selected && <section class="music-section"><div class="section-title"><h2>读一首歌，接着听。</h2><p>手记与解读均注明整理依据</p></div><div class="song-index">{songs.map(([id,title,description,kind])=><a href={`${selected}/songs/${id}/`} target="_blank" rel="noopener noreferrer"><span>{kind}</span><strong>{title} ↗</strong><small>{description}</small></a>)}</div></section>}
 <section class="music-connection"><h2>声音之外，<br/>表达还在继续。</h2><div><p>同名 MV 把歌曲带进运动的画面，文章记录创作之外的观察。音乐、影像与文字来自同一个创作者，也各自有值得停留的地方。</p><div class="actions"><a href="/works" class="button secondary">看影像作品 →</a><a href="/notes" class="button secondary">读文章 →</a><a href="/about" class="button secondary">关于 violin →</a></div></div></section>
</BaseLayout>
<style>
.music-hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:65px;align-items:center;padding:72px 0 64px}.music-hero h1{font-size:clamp(44px,6vw,76px);line-height:1.15;letter-spacing:-.045em;margin:20px 0 24px}.hero-intro{max-width:34em;font-size:15px;line-height:2;color:var(--quiet)}.music-entries{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.music-entries a{gap:12px;white-space:nowrap}.disc{width:min(100%,400px);aspect-ratio:1;border-radius:50%;background:repeating-radial-gradient(#27251f 0 2px,#171611 3px 5px);display:grid;place-items:center;box-shadow:12px 14px 0 #e4dfd3;justify-self:center}.disc span{background:var(--or);color:var(--paper);width:36%;aspect-ratio:1;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font:italic 32px var(--serif)}.disc small{font:8px var(--mono);margin-top:8px}
.small{font-size:12px;line-height:1.9;color:var(--quiet);margin-top:24px}.music-section{margin-top:64px}.section-title p{font-size:12px;line-height:1.8;color:var(--quiet)}.song-index{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 32px}.song-index a{display:flex;flex-direction:column;gap:12px;padding:20px 0;border-bottom:1px solid var(--faint);text-decoration:none}.song-index strong{font:24px var(--serif)}.song-index span{font:10px var(--mono);color:var(--or)}.song-index small{font-size:12px;color:var(--quiet);line-height:1.9}.music-connection{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;background:#e8e4d9;padding:40px;margin-top:64px}.music-connection h2{font:700 34px/1.4 var(--serif);margin:0}.music-connection p{font-size:14px;line-height:2;color:var(--quiet)}.music-connection .button{font-size:12px;padding:12px 18px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:720px){.music-hero{grid-template-columns:1fr;padding:40px 0 48px;gap:36px}.music-hero h1{font-size:50px}.music-entries{display:grid;grid-template-columns:1fr;margin-top:22px;gap:8px}.music-entries a{justify-content:space-between;min-height:46px}.disc{width:220px;box-shadow:8px 10px 0 #e4dfd3}.disc span{font-size:23px}.disc small{font-size:6px}.section-title{flex-wrap:wrap;padding-bottom:22px}.section-title p{width:100%}.song-index{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.song-index strong{font-size:21px}.music-connection{grid-template-columns:1fr;gap:24px;padding:24px}.music-connection h2{font-size:30px}}
</style>
