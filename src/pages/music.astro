---
import BaseLayout from '../components/BaseLayout.astro';
import SiteCard from '../components/SiteCard.astro';
import { getSites } from '../lib/sites.mjs';
const musicSites = getSites({ category: 'creative' }).filter(site => site.tags.includes('音乐'));
const selectedSite = musicSites.find(site => site.id === 'album-room');
const selected = selectedSite?.url.replace(/\/$/, '');
const lines = musicSites.filter(site => site.id !== 'album-room');
const collections = [
 {id:'graduation',title:'六月之后',count:4,description:'毕业季 / 同桌、合照与新的出发'},
 {id:'convenience-store',title:'便利店，夜还亮着',count:6,description:'便利店 / 白灯、热食与夜班的人'},
 {id:'memory-darkroom',title:'记忆的暗房',count:3,description:'时间、身体与记忆的显影'},
 {id:'unspoken',title:'尚未说出口',count:3,description:'语言、相遇与表达'}
];
const selectedCount = collections.reduce((total, collection) => total + collection.count, 0);
const songs = [
 ['dingying','定影','记忆慢慢显影','创作手记'],['qiwei','气味先到','身体比语言更早记得','创作手记'],['nianlun','年轮','持续记录，持续生长','创作手记'],
 ['tuigejian','退格键','一次终于留下的表达','作品解读'],['lingdian','零点前三十秒','陌生人之间短暂的共同体','创作手记'],['zhangwen','掌纹','表达里不可复制的痕迹','创作手记']
];

---
<BaseLayout title="音乐" description="violin 的音乐地图：主题选集、单曲创作手记，以及灵感、番茄和风格三条各有方向的持续创作线。">
 <header class="page-head"><p class="eyebrow">Listening room / Violin’s Listening Room</p><h1>把感受，<br/>留在声音里。</h1><p>音乐是创作现场的另一种写作。专辑听室把作品编成主题选集；三条创作线持续留下新的歌。它们出发点各异，在这里相遇。</p></header>
 {selectedSite && <section class="record">{selectedSite && <SiteCard site={selectedSite} sizes="(max-width: 720px) calc(100vw - 44px), (max-width: 1320px) calc((100vw - 177px) / 2), 572px" />}<div><p class="eyebrow">主题编选 / {selectedCount} 首作品 · {collections.length} 张选集</p><h2>先慢慢听完一张唱片。</h2><p>从毕业季的一次告别，到便利店的一盏夜灯。<br/>“记忆的暗房”与“尚未说出口”也继续留在这里。</p><div class="actions"><a href="/works/dingying-fix" class="button secondary">从《定影》走向影像 →</a></div><p class="small">在新窗口打开，播放由你开始。音乐站的红心仅保存在当前浏览器，不跨设备或跨站同步。</p></div></section>}
 {selected && <section class="music-section"><div class="section-title"><h2>选一张，慢慢听。</h2><p>每张选集沿着自己的曲序</p></div><div class="song-index">{collections.map(collection=><a href={`${selected}/collections/${collection.id}/`} target="_blank" rel="noopener noreferrer"><span>主题选集 / {collection.count} 首</span><strong>{collection.title} ↗</strong><small>{collection.description}</small></a>)}</div></section>}
 {selected && <section class="music-section"><div class="section-title"><h2>读一首歌，接着听。</h2><p>手记与解读均注明整理依据</p></div><div class="song-index">{songs.map(([id,title,description,kind])=><a href={`${selected}/songs/${id}/`} target="_blank" rel="noopener noreferrer"><span>{kind}</span><strong>{title} ↗</strong><small>{description}</small></a>)}</div></section>}
 <section class="music-section"><div class="section-title"><h2>三条路，各自有回声。</h2><p>持续创作曲库，保留各自的方向</p></div><div class="site-grid">{lines.map(site => <SiteCard site={site} />)}</div></section>
 <section class="music-connection"><h2>声音之外，<br/>表达还在继续。</h2><div><p>同名 MV 把歌曲带进运动的画面，文章记录创作之外的观察。音乐、影像与文字来自同一个创作者，也各自有值得停留的地方。</p><div class="actions"><a href="/works" class="button secondary">看影像作品 →</a><a href="/notes" class="button secondary">读文章 →</a><a href="/about" class="button secondary">关于 violin →</a></div></div></section>
</BaseLayout>
<style>
.record{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:65px;align-items:center;padding:40px 0}h2{font:700 34px/1.4 var(--serif);margin:20px 0}p{font-size:15px;line-height:2;color:var(--quiet)}.small{font-size:12px;margin-top:22px}.music-section{margin-top:64px}.section-title{display:flex;align-items:baseline;justify-content:space-between;gap:24px;border-top:1px solid var(--ink);padding:12px 0 24px}.section-title h2{font-size:30px}.section-title p{font-size:12px}.song-index{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 32px}.song-index a{display:flex;flex-direction:column;gap:12px;padding:20px 0;border-bottom:1px solid var(--faint);text-decoration:none}.song-index strong{font:24px var(--serif)}.song-index span{font:10px var(--mono);color:var(--or)}.song-index small{font-size:12px;color:var(--quiet)}.music-connection{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;background:#e8e4d9;padding:40px;margin-top:64px}.music-connection h2{margin:0}.music-connection .button{font-size:12px;padding:12px 18px}@media(max-width:720px){.record{grid-template-columns:1fr;gap:40px}.section-title{display:block;padding-bottom:16px}.section-title h2{font-size:28px}.song-index{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.song-index strong{font-size:21px}.music-connection{grid-template-columns:1fr;gap:24px;padding:24px}h2{font-size:30px}}
</style>
