---
import BaseLayout from '../components/BaseLayout.astro';
const selected = 'https://music.beyondmotion.net';
const collections = [
 {id:'graduation',title:'六月之后',count:4,description:'毕业季 / 同桌、合照与新的出发'},
 {id:'convenience-store',title:'便利店，夜还亮着',count:6,description:'便利店 / 白灯、热食与夜班的人'},
 {id:'memory-darkroom',title:'记忆的暗房',count:3,description:'时间、身体与记忆的显影'},
 {id:'unspoken',title:'尚未说出口',count:3,description:'语言、相遇与表达'}
];
const selectedCount = collections.reduce((total, collection) => total + collection.count, 0);
const songs = [
 ['dingying','定影','记忆慢慢显影','创作手记'],['qiwei','气味先到','身体比语言更早记得','创作手记'],['nianlun','年轮','持续记录，持续生长','创作手记'],
 ['tuigejian','退格键','一次终于留下的表达','作品解读'],['lingdian','零点前三十秒','陌生人之间短暂的共同体','创作手记'],['zhangwen','掌纹','表达里不可复制的痕迹','创作手记']
];
const lines = [
 {number:'01', title:'灵感音乐', label:'主题先行 / 音乐日记', description:'从阅读、观察与成长出发，先找一个值得表达的感受，再为它选择声音。公开作品与主题概括，私人资料留在工作档案。', url:'https://music.1986318.xyz', color:'#9d451f'},
 {number:'02', title:'番茄音乐报', label:'日常场景 / 五种口味', description:'能跟着唱的副歌，直白而浓烈的情绪。广场舞、洗脑流行、伤感、国风与家乡故事，从今天的心情挑一首。', url:'https://tomato.1986318.xyz', color:'#a72b24'},
 {number:'03', title:'风格听室', label:'曲风入口 / 声音探索', description:'沿摇滚、爵士、民谣和更多曲风浏览独立作品，探索不同的节奏、叙述和声音性格。', url:'https://style.1986318.xyz', color:'#24594e'}
];
---
<BaseLayout title="音乐" description="violin 的音乐地图：主题选集、单曲创作手记，以及灵感、番茄和风格三条各有方向的持续创作线。">
 <header class="page-head"><p class="eyebrow">Listening room / Violin’s Listening Room</p><h1>把感受，<br/>留在声音里。</h1><p>音乐是创作现场的另一种写作。专辑听室把作品编成主题选集；三条创作线持续留下新的歌。它们出发点各异，在这里相遇。</p></header>
 <section class="record"><div class="disc" aria-hidden="true"><span>violin<br/><small>SIDE A · SELECTED</small></span></div><div><p class="eyebrow">主题编选 / {selectedCount} 首作品 · {collections.length} 张选集</p><h2>先慢慢听完一张唱片。</h2><p>从毕业季的一次告别，到便利店的一盏夜灯。<br/>“记忆的暗房”与“尚未说出口”也继续留在这里。</p><div class="actions"><a class="button" href={selected} target="_blank" rel="noopener noreferrer">进入专辑听室 ↗</a><a href="/works/dingying-fix" class="button secondary">从《定影》走向影像 →</a></div><p class="small">在新窗口打开，播放由你开始。音乐站的红心仅保存在当前浏览器，不跨设备或跨站同步。</p></div></section>
 <section class="music-section"><div class="section-title"><h2>选一张，慢慢听。</h2><p>每张选集沿着自己的曲序</p></div><div class="song-index">{collections.map(collection=><a href={`${selected}/collections/${collection.id}/`} target="_blank" rel="noopener noreferrer"><span>主题选集 / {collection.count} 首</span><strong>{collection.title} ↗</strong><small>{collection.description}</small></a>)}</div></section>
 <section class="music-section"><div class="section-title"><h2>读一首歌，接着听。</h2><p>手记与解读均注明整理依据</p></div><div class="song-index">{songs.map(([id,title,description,kind])=><a href={`${selected}/songs/${id}/`} target="_blank" rel="noopener noreferrer"><span>{kind}</span><strong>{title} ↗</strong><small>{description}</small></a>)}</div></section>
 <section class="music-section"><div class="section-title"><h2>三条路，各自有回声。</h2><p>持续创作曲库，保留各自的方向</p></div><div class="line-grid">{lines.map(line=><article style={`--line-accent:${line.color}`}><p class="eyebrow">{line.number} / {line.label}</p><h3>{line.title}</h3><p>{line.description}</p><a class="line-entry" href={line.url} target="_blank" rel="noopener noreferrer">进入{line.title} ↗</a></article>)}</div></section>
 <section class="music-connection"><h2>声音之外，<br/>表达还在继续。</h2><div><p>同名 MV 把歌曲带进运动的画面，文章记录创作之外的观察。音乐、影像与文字来自同一个创作者，也各自有值得停留的地方。</p><div class="actions"><a href="/works" class="button secondary">看影像作品 →</a><a href="/notes" class="button secondary">读文章 →</a><a href="/about" class="button secondary">关于 violin →</a></div></div></section>
</BaseLayout>
<style>
.record{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center;padding:40px 0}.disc{width:min(100%,400px);aspect-ratio:1;border-radius:50%;background:repeating-radial-gradient(#27251f 0 2px,#171611 3px 5px);display:grid;place-items:center;box-shadow:12px 14px 0 #e4dfd3}.disc span{background:var(--or);color:var(--paper);width:36%;aspect-ratio:1;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font:italic 32px var(--serif)}.disc small{font:8px var(--mono);margin-top:8px}h2{font:700 34px/1.4 var(--serif);margin:20px 0}p{font-size:15px;line-height:2;color:var(--quiet)}.small{font-size:12px;margin-top:22px}.music-section{margin-top:64px}.section-title{display:flex;align-items:baseline;justify-content:space-between;gap:24px;border-top:1px solid var(--ink);padding:12px 0 24px}.section-title h2{font-size:30px}.section-title p{font-size:12px}.song-index{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 32px}.song-index a{display:flex;flex-direction:column;gap:12px;padding:20px 0;border-bottom:1px solid var(--faint);text-decoration:none}.song-index strong{font:24px var(--serif)}.song-index span{font:10px var(--mono);color:var(--or)}.song-index small{font-size:12px;color:var(--quiet)}.line-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.line-grid article{border-top:3px solid var(--line-accent);background:#e8e4d9;padding:28px;display:flex;flex-direction:column;align-items:flex-start}.line-grid .eyebrow{font-size:10px;color:var(--line-accent)}.line-grid h3{font:30px var(--serif);margin:20px 0}.line-grid p{font-size:13px}.line-entry{display:inline-flex;align-items:center;min-height:44px;padding-top:20px;font-size:13px;color:var(--line-accent);margin-top:auto}.music-connection{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;background:#e8e4d9;padding:40px;margin-top:64px}.music-connection h2{margin:0}.music-connection .button{font-size:12px;padding:12px 18px}@media(max-width:720px){.record{grid-template-columns:1fr;gap:40px}.disc{width:80%;margin:auto;order:2}.section-title{display:block;padding-bottom:16px}.section-title h2{font-size:28px}.song-index{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.song-index strong{font-size:21px}.line-grid{grid-template-columns:1fr;gap:24px}.music-connection{grid-template-columns:1fr;gap:24px;padding:24px}h2{font-size:30px}}
</style>
